  "cards": [
    {
      "dot": "emerald",
      "title": "两类 PostgreSQL 表，同一事实环境",
      "items": [
        "ws_* 管业务身份、版本、依赖、会话与评价；aw_* 管执行事实。",
        "Space 提交可把资产、输出绑定、步骤收据和事件放进同一 PG 事务。"
      ]
    },
    {
      "dot": "cyan",
      "title": "对象存储只承载字节",
      "items": [
        "R2 PUT → GET 校验 → PG BlobManifest → 准确 AssetVersion 附件。",
        "对象写入和 PG 不是跨系统事务；相同内容键重试对账，孤儿清理尚未实现。"
      ]
    },
    {
      "dot": "amber",
      "title": "范围与证据",
      "items": [
        "真实 R2 / 隔离 PG / CLI 上传导入及重开下载通过；工作台独立实用验收另列。",
        "单对象 ≤16 MiB；大媒体、自动清理、备份恢复及生产多租户仍待建设。",
        "图源为本轮工作树的隔离源码快照，revision 不表示主仓库已提交。"
      ]
    }
