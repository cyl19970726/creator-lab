# Store this outside the repository with owner-only permissions.
WORKBENCH_HOST=127.0.0.1
WORKBENCH_PORT=4341
WORKBENCH_PUBLIC_ORIGIN=https://creation.example.com
WORKBENCH_STATE_ROOT=/var/lib/creator-workbench/state
WORKBENCH_ACTOR_ID=creator
# Generate independent values: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WORKBENCH_ACCESS_TOKEN=REPLACE_ME_WITH_A_RANDOM_SECRET
# Issue temporary Agent A credentials through /api/workbench/review-assignments.
# Each credential is restricted to exact assigned artifact versions.
CREATION_WORKBENCH_CODEX_HOME=/var/lib/creator-workbench/codex
CREATION_CODEX_BIN=/opt/codex/bin/codex
# Optional B3 templates, read from operator-owned deployment configuration only.
# CREATION_B3_TEMPLATE_DIR=/opt/creator-assets/template
# CREATION_B3_REFERENCE_DIR=/opt/creator-assets/reference
