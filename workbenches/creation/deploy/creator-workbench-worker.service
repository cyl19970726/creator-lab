[Unit]
Description=Creator business workflow worker
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=creator-workbench
Group=creator-workbench
WorkingDirectory=/opt/creator-lab/workbenches/creation
EnvironmentFile=/etc/creator-workbench.env
ExecStart=/usr/local/bin/node --import tsx apps/workbench/worker.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
KillMode=control-group
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/creator-workbench
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
