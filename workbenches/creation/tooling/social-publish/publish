#!/bin/bash
set -euo pipefail
# Resolve arguments before changing directory. Base64 transfers data, never executable job text.
if [[ $# -ge 2 ]]; then
  job_path=$(node -e 'process.stdout.write(require("node:path").resolve(process.argv[1]))' -- "$2")
  set -- "$1" "$job_path" "${@:3}"
fi
if [[ "${1:-}" == "review" && $# -ge 4 ]]; then
  review_path=$(node -e 'process.stdout.write(require("node:path").resolve(process.argv[1]))' -- "$4")
  set -- "$1" "$2" "$3" "$review_path"
fi
# Local operations retain caller cwd so output paths are predictable.
script_dir=$(cd -- "$(dirname -- "$0")" && pwd)
case "${1:---help}" in
  check|test|pack|covers|status|review|--help) exec node "$script_dir/local.mjs" "$@" ;;
esac
cd -- "$script_dir"
payload=$(node --input-type=module -e 'import {readJob} from "./core.mjs";const args=process.argv.slice(1);const job=readJob(args[1]);process.stdout.write(Buffer.from(JSON.stringify({root:process.cwd(),args,job})).toString("base64"))' -- "$@")
ego-browser nodejs <<EOF_JS
const payload=JSON.parse(Buffer.from('$payload','base64').toString());
const {pathToFileURL}=await import('node:url');
const {run}=await import(pathToFileURL(payload.root+'/runtime.mjs').href);
await run({taskSpace,profiles,listTaskSpaces,takeOverTaskSpace},payload.args,payload.job);
EOF_JS
