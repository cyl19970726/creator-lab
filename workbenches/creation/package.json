{
  "name": "@creator-lab/creation",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/space-workbench.ts",
    "dev:web": "vite --config apps/space-workbench/web/vite.config.ts",
    "build": "pnpm typecheck && vite build --config apps/space-workbench/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "test:publish": "node --test tooling/social-publish/*.test.mjs",
    "check": "pnpm typecheck && pnpm test && pnpm build",
    "b3": "tsx scripts/run-b3.ts",
    "history:archive-sqlite": "tsx scripts/history-sqlite-archive.ts",
    "space:demo": "tsx scripts/space-demo.ts",
    "space:console": "tsx scripts/space-console.ts",
    "content:workbench": "tsx scripts/content-workbench.ts",
    "content:space": "tsx scripts/content-space.ts",
    "space:workbench": "tsx scripts/space-workbench.ts"
  },
  "dependencies": {
    "@signal-room/workflow": "workspace:*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0",
    "@signal-room/workflow-space-contracts": "workspace:*",
    "@signal-room/workflow-spaces": "workspace:*",
    "@signal-room/workflow-postgres": "workspace:*",
    "pg": "8.23.1",
    "@signal-room/workflow-agent-sdk": "workspace:*",
    "@signal-room/workflow-space-api": "workspace:*",
    "@signal-room/workflow-workbench-ui": "workspace:*",
    "react-router": "7.18.4",
    "@tanstack/react-query": "^5.0.0"
  },
  "devDependencies": {
    "esbuild": "0.25.9",
    "@playwright/test": "1.55.0",
    "typescript": "~5.9.3",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.4",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/pg": "8.23.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
