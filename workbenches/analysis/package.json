{
  "name": "@creator-lab/analysis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite",
    "dev:worker": "SELF_MEDIA_EMBED_WORKERS=false tsx watch apps/worker/src/main.ts",
    "selfmedia": "tsx apps/cli/src/main.ts",
    "worker": "tsx apps/worker/src/main.ts",
    "build:workflow": "pnpm --filter @signal-room/workflow --filter @signal-room/workflow-postgres --filter @signal-room/workflow-space-contracts --filter @signal-room/workflow-spaces --filter @signal-room/workflow-skill-snapshot --filter @signal-room/workflow-agent-sdk --filter @signal-room/workflow-read-model run build",
    "predev": "pnpm build:workflow",
    "predev:api": "pnpm build:workflow",
    "predev:web": "pnpm build:workflow",
    "predev:worker": "pnpm build:workflow",
    "preworker": "pnpm build:workflow",
    "preselfmedia": "pnpm build:workflow",
    "pretypecheck": "pnpm build:workflow",
    "pretest": "pnpm build:workflow",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:evidence": "node scripts/require-evidence-root.mjs && vitest run",
    "test:workflow": "vitest run --config ../../vendor/agent-workflow/vitest.config.ts",
    "build": "pnpm typecheck && vite build && tsc -p tsconfig.server.json",
    "smoke:entrypoints": "node scripts/smoke-entrypoints.mjs",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && pnpm build && pnpm smoke:entrypoints",
    "start": "SELF_MEDIA_WEB_URL=http://127.0.0.1:4310 NODE_ENV=production node dist-server/apps/api/src/main.js",
    "start:worker": "NODE_ENV=production node dist-server/apps/worker/src/main.js",
    "lapian:harness": "tsx scripts/lapian-harness.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.6",
    "@fontsource/ibm-plex-sans-condensed": "^5.2.6",
    "commander": "^14.0.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "undici": "^7.29.0",
    "zod": "^3.25.76",
    "@signal-room/workflow": "workspace:*",
    "@signal-room/workflow-read-model": "workspace:*",
    "@signal-room/workflow-postgres": "workspace:*",
    "@signal-room/workflow-agent-sdk": "workspace:*",
    "@signal-room/workflow-spaces": "workspace:*",
    "@signal-room/workflow-space-contracts": "workspace:*",
    "pg": "8.23.1",
    "@signal-room/workflow-skill-snapshot": "workspace:*",
    "@signal-room/workflow-space-api": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@types/express": "^5.0.3",
    "@types/node": "^24.2.1",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.33.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vite": "^7.1.2",
    "vitest": "^3.2.4",
    "@types/pg": "8.23.1"
  }
}
