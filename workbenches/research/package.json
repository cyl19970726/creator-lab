{
  "name": "research-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build:workflow": "pnpm --filter @signal-room/workflow build && pnpm --filter @signal-room/workflow-agent-sdk build && pnpm --filter @signal-room/workflow-skill-snapshot build && pnpm --filter @signal-room/workflow-postgres build && pnpm --filter @signal-room/workflow-read-model build",
    "build": "pnpm build:workflow && vite build --config apps/web/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test packages/**/*.test.* scripts/*.test.mjs apps/api/*.test.* apps/web/src/*.test.ts",
    "check": "pnpm build && pnpm typecheck && pnpm test",
    "api": "node --import tsx apps/api/main.ts",
    "worker": "node --import tsx apps/worker/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "@signal-room/workflow": "workspace:*",
    "@signal-room/workflow-agent-sdk": "workspace:*",
    "@signal-room/workflow-skill-snapshot": "workspace:*",
    "@signal-room/workflow-postgres": "workspace:*",
    "@signal-room/workflow-read-model": "workspace:*",
    "fastify": "^5.6.0",
    "@fastify/static": "^8.3.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.1.0",
    "markdown-it": "^14.1.0",
    "pg": "^8.23.1",
    "mermaid": "^11.12.0"
  },
  "devDependencies": {
    "typescript": "~5.9.3",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.0",
    "vite": "^7.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/markdown-it": "^14.1.0"
  }
}
